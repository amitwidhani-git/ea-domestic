# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# MongoDB — same connection string as the pipeline
MONGODB_URI=
MONGODB_DB=edgeanalysts

# Affiliate click tracking collection (optional, defaults to "clicks")
MONGODB_CLICKS_COLLECTION=clicks

# Auth / subscribe
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Mailchimp (optional, stub works without it)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=

# Feature toggle — subscribe/register widget hidden until this is "true"
NEXT_PUBLIC_SUBSCRIBE_ENABLED=false
