# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# MongoDB — same connection string as the pipeline
MONGODB_URI=
MONGODB_DB=edgeanalysts

# Affiliate click tracking collection (optional, defaults to "clicks")
MONGODB_CLICKS_COLLECTION=clicks

# Auth / subscribe
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Brevo (optional, stub works without it)
BREVO_API_KEY=
BREVO_LIST_ID=2
BREVO_TEMPLATE_ID=1
# Signs Brevo's webhook POSTs to /api/unsubscribe — optional, verification is
# skipped if unset. Get the real value from the Brevo webhook config UI.
BREVO_WEBHOOK_SECRET=

# Signs unsubscribe links (?email=...&token=...) so nobody can unsubscribe an
# address they don't have a valid link for.
UNSUBSCRIBE_SECRET=2100a3a71148557264d676d5ba48e6f9f53878062941afe22e3972aad32adff3

# Feature toggle — subscribe/register widget hidden until this is "true"
NEXT_PUBLIC_SUBSCRIBE_ENABLED=false

# Feature toggle — Match Intelligence widget hidden until this is "true"
NEXT_PUBLIC_MATCH_WIDGET_ENABLED=false

# API-Football (v3.football.api-sports.io) — powers /api/live-scores.
API_FOOTBALL_KEY=
